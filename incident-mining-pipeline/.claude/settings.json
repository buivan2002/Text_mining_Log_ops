{
  "permissions": {
    "allow": [
      "Bash(pip install *)",
      "Bash(pip freeze*)",
      "Bash(pytest*)",
      "Bash(uvicorn *)",
      "Bash(streamlit run *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(docker-compose *)",
      "Bash(docker compose *)",
      "Read",
      "Edit(src/**)",
      "Edit(tests/**)",
      "Edit(scripts/**)",
      "Edit(ui/**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Edit(.env)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(docker-compose down*)",
      "Bash(docker compose down*)"
    ]
  }
}
